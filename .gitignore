# ═══════════════════════════════════════════════════
# BioSphere — .gitignore
# ═══════════════════════════════════════════════════

# ── Dependencies ────────────────────────────────────
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js build output ───────────────────────────
/.next/
/out/
/build/
next-env.d.ts

# ── TypeScript ──────────────────────────────────────
*.tsbuildinfo

# ── Testing ─────────────────────────────────────────
/coverage/

# ── Environment variables ──────────────────────────
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Vercel ──────────────────────────────────────────
.vercel

# ── Debug logs ──────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS files ────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~

# ── IDE / Editor ────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.history/

# ── Misc ────────────────────────────────────────────
*.pem
*.log
